name: ci

on:
  pull_request:
    branches: [main]

jobs:
  tests:
    name: Tests
    runs-on: ubuntu-latest

    steps:
      - name: Check out code
        uses: actions/checkout@v6

      - name: Set up Go
        uses: actions/setup-go@v6
        with:
          go-version: "1.27.1"

      - name: Run go test
        run: |
    	  echo "Current directory:"
   	  pwd

          echo "Current Go module:"
          go env GOMOD

          echo "Test file:"
          cat internal/auth/get_api_key_test.go

    echo "Running all tests:"
    go test -count=1 -v ./...	
